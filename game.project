[project]
title = JamOfficePsychosis
dependencies#0 = https://github.com/subsoap/defos/archive/refs/tags/v2.8.7.zip

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 1920
height = 1080
high_dpi = 1
fullscreen = 0

[script]
shared_state = 1

[windows]
app_icon = /assets/app_icons/appicon.ico

[osx]
app_icon = /assets/app_icons/appicon.icns

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01
velocity_threshold = 100.0

[html5]
scale_mode = stretch

[collectionfactory]
max_count = 1280

[collection]
max_instances = 10240
max_input_stack_entries = 160

[collection_proxy]
max_count = 80

[factory]
max_count = 1280

[gui]
max_count = 640
max_animation_count = 10240
max_particle_count = 10240
max_particlefx_count = 640

[label]
max_count = 640

[light]
max_count = 640

[mesh]
max_count = 1280

[model]
max_count = 1280
max_bone_matrix_texture_width = 10240
max_bone_matrix_texture_height = 10240
max_morph_target_texture_width = 10240
max_morph_target_texture_height = 10240

[particle_fx]
max_particle_count = 10240
max_particle_buffer_count = 10240
max_count = 640
max_emitter_count = 640

[sound]
max_sound_data = 1280
max_sound_buffers = 320
max_sound_sources = 160
max_sound_instances = 2560
max_component_count = 320

[sprite]
max_count = 1280

[tilemap]
max_count = 160
max_tile_count = 20480

