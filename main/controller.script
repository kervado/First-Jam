--------------------------------------------------------------------------------
-- controller.script
--
-- The single "brain" of a level. Every playable object (player, desks, item
-- sources, obstacles) is a hand-placed instance in the .collection that
-- registers itself here at load time, so objects can be freely added / removed /
-- moved / resized in the editor -- nothing is created at runtime.
--
-- Each object's collision rectangle IS its sprite: its footprint is read as
-- (sprite size x instance scale), so resizing the coloured square on the field
-- changes the collision box to match.
--
-- Items: the assistant can carry only ONE type at a time. Touching a source
-- refills that type to its limit and drops whatever else was held. A worker
-- wants exactly one item type (chosen by that desk's weights) and is only
-- satisfied by that type.
--
-- Requests / psychosis (see the block comments below the constants) drive the
-- pacing of the level.
--------------------------------------------------------------------------------

local items = require("main.items")
local office = require("main.office")

-- how many requests may be active at once. No new request is created while the
-- active count is at this cap.
go.property("MaxActiveRequests", 3)
-- how often (seconds) the controller tries to hand out a new request.
go.property("ChekFrequency", 1.0)
-- round duration in seconds. Win the level when it reaches zero. Set per level.
go.property("RoundTime", 180)
-- floor / round number, shown in the HUD as "N ЭТАЖ". Set per level.
go.property("Floor", 1)

-- Psychosis added ONCE when a request of each type times out unfulfilled (%).
go.property("miss_coffee", 5)
go.property("miss_paper", 3)
go.property("miss_cat", 10)

-- Cooldown (seconds, per type) a desk waits after a request ends -- whether it
-- was fulfilled or timed out -- before it can join the request pool again.
go.property("cooldown_coffee", 3)
go.property("cooldown_paper", 5)
go.property("cooldown_cat", 8)

-- Patience window (seconds, per type): a fresh request waits a random time in
-- [min, max]; if not delivered by then it times out.
go.property("wait_coffee_min", 5)
go.property("wait_coffee_max", 10)
go.property("wait_paper_min", 15)
go.property("wait_paper_max", 20)
go.property("wait_cat_min", 8)
go.property("wait_cat_max", 13)

local SPEED         = 320      -- max horizontal pixels / second
local ISO_RATIO     = 0.58     -- classic isometric height/width; movement only
local ACCEL_TIME    = 0.5      -- seconds to reach max speed, and to brake to 0
local CONTACT_PAD   = 8        -- how close counts as "touching" for interactions

local ROOM_W        = 1920
local ROOM_H        = 1080

-- adaptive music cross-fade speed (gain units per second; ~1.5s for a full swap)
local MUSIC_FADE = 0.66

--------------------------------------------------------------------------------

local function rand_range(range)
	return range[1] + math.random() * (range[2] - range[1])
end

-- move `cur` towards `target` by at most `maxstep`
local function approach(cur, target, maxstep)
	if cur < target then return math.min(cur + maxstep, target) end
	if cur > target then return math.max(cur - maxstep, target) end
	return cur
end

-- pick an item type from relative weights {coffee, paper, cats}
local function weighted_pick(w)
	local total = (w.coffee or 0) + (w.paper or 0) + (w.cats or 0)
	if total <= 0 then return items.COFFEE end   -- fallback for a mis-configured desk
	local r = math.random() * total
	if r < w.coffee then return items.COFFEE end
	r = r - w.coffee
	if r < w.paper then return items.PAPER end
	return items.CAT
end

-- AABB overlap: centres + half-extents
local function aabb(ax, ay, ahw, ahh, bx, by, bhw, bhh)
	return math.abs(ax - bx) < (ahw + bhw) and math.abs(ay - by) < (ahh + bhh)
end

-- can the player centre sit at (px, py) without entering any solid?
local function is_free(self, px, py)
	local p = self.player
	for _, s in ipairs(self.solids) do
		if aabb(px, py, p.hw, p.hh, s.x, s.y, s.hw, s.hh) then
			return false
		end
	end
	return true
end

-- is the (inflated) player touching box b?
local function touching(self, b)
	local p = self.player
	return aabb(p.x, p.y, p.hw + CONTACT_PAD, p.hh + CONTACT_PAD, b.x, b.y, b.hw, b.hh)
end

-- number of desks that currently have an undelivered request
local function count_active(self)
	local n = 0
	for _, d in ipairs(self.desks) do
		if d.active then n = n + 1 end
	end
	return n
end

-- desks ready to request again, in random order (Fisher-Yates shuffle)
local function shuffled_ready(self)
	local list = {}
	for _, d in ipairs(self.desks) do
		if d.ready then list[#list + 1] = d end
	end
	for i = #list, 2, -1 do
		local j = math.random(i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- hand a fresh request to desk d
local function give_request(self, d)
	d.active  = true
	d.ready   = false
	d.want    = weighted_pick(d.w)
	d.wait    = rand_range(self.wait_range[d.want])
	msg.post(msg.url(nil, d.id, "script"), "show_icon", { type = d.want })
end

-- once per ChekFrequency: maybe promote ONE ready desk to a new request
local function try_new_request(self)
	local maxreq = self.MaxActiveRequests
	if maxreq <= 0 then return end

	local active = count_active(self)
	if active >= maxreq then return end          -- never exceed the cap

	-- probability that a checked desk raises a request this pass
	local prob = 1 - (active / maxreq)
	if prob <= 0 then return end

	for _, d in ipairs(shuffled_ready(self)) do
		if math.random() < prob then
			give_request(self, d)
			return                               -- one request per check, then stop
		end
	end
end

--------------------------------------------------------------------------------

function init(self)
	msg.post(".", "acquire_input_focus")
	math.randomseed(os.time())
	math.random(); math.random()

	self.move             = { up = false, down = false, left = false, right = false }
	self.vx               = 0       -- current velocity (accelerates / brakes)
	self.vy               = 0
	self.facing           = 0       -- euler.y: 0 faces right, 180 faces left
	self.last_moving      = false   -- last reported walking/standing state
	self.carry_type       = nil    -- item type currently held (hash) or nil
	self.carry_count      = 0
	self.last_carry_type  = false   -- forces a first HUD refresh
	self.last_carry_count = -1

	self.solids   = {}   -- everything the player cannot pass through
	self.desks    = {}   -- desks (subset of solids) with request state
	self.sources  = {}   -- item sources (subset of solids): coffee/paper/cat
	self.player   = nil  -- filled in when the player registers
	self.floor    = nil  -- walkable rectangle {x, y, hw, hh}, from the floor object

	-- per-item tuning, built from the properties above
	self.wait_range = {
		[items.COFFEE] = { self.wait_coffee_min, self.wait_coffee_max },
		[items.PAPER]  = { self.wait_paper_min, self.wait_paper_max },
		[items.CAT]    = { self.wait_cat_min, self.wait_cat_max },
	}
	self.cooldown = {
		[items.COFFEE] = self.cooldown_coffee,
		[items.PAPER]  = self.cooldown_paper,
		[items.CAT]    = self.cooldown_cat,
	}
	self.miss = {   -- one-time psychosis % added when a request times out
		[items.COFFEE] = self.miss_coffee,
		[items.PAPER]  = self.miss_paper,
		[items.CAT]    = self.miss_cat,
	}

	-- level-wide psychosis meter (0..100), raised by impatient workers.
	-- lives in the shared office module so every object can read it; reset here
	-- so it starts clean even if the level collection is reloaded.
	office.psychosis = 0
	self.psychosis_shown = 0

	-- request pacing
	self.check_timer = self.ChekFrequency

	-- round timer: counts down from RoundTime; win the level at zero
	self.time_left    = self.RoundTime
	self.round_over   = false
	self.clock_shown  = -1
	self.floor_shown  = false -- HUD floor label sent on the first update frame

	-- looping office ambience (master group -> the volume slider controls it)
	msg.post("#ambience", "play_sound")

	-- adaptive music: three looping tracks played at once, cross-faded by stress
	-- (0-33 calm, 34-66 stress, 67+ psycho). All start silent; the active one
	-- fades in. gain is driven per-frame in update().
	self.music = {
		{ url = "#music_calm",   gain = 0 },
		{ url = "#music_stress", gain = 0 },
		{ url = "#music_psycho", gain = 0 },
	}
	for _, m in ipairs(self.music) do
		sound.play(m.url)
		sound.set_gain(m.url, 0)
	end
end

function on_message(self, message_id, message, sender)
	if message_id ~= hash("register") then return end

	local box = {
		id = message.id,
		x = message.x, y = message.y, z = message.z,
		hw = message.hw, hh = message.hh,
	}
	local kind = message.kind

	if kind == hash("player") then
		self.player = box
	elseif kind == hash("floor") then
		-- the floor is walkable, not a solid: it defines the movement bounds
		self.floor = box
	elseif kind == hash("desk") then
		-- every desk starts idle and ready to request (zero cooldown)
		box.active   = false
		box.want     = nil
		box.wait     = 0
		box.cooldown = 0
		box.ready    = true
		box.w = { coffee = message.w_coffee, paper = message.w_paper, cats = message.w_cats }
		table.insert(self.desks, box)
		table.insert(self.solids, box)
	elseif items.MAX[kind] then
		-- a source: kind is the item type it dispenses (coffee / paper / cat)
		box.item = kind
		box.max  = items.MAX[kind]
		table.insert(self.sources, box)
		table.insert(self.solids, box)
	else
		-- plain obstacle
		table.insert(self.solids, box)
	end
end

function update(self, dt)
	-- send the floor label once, from update (game_ui is reliably ready here,
	-- unlike during init when the level is loaded through a proxy)
	if not self.floor_shown then
		self.floor_shown = true
		msg.post("/game_ui#game_gui", "set_floor", { floor = self.Floor })
	end

	-- ---- round timer: win when it reaches zero (dt is 0 while paused) ----
	if not self.round_over then
		self.time_left = self.time_left - dt
		local shown = math.max(0, math.ceil(self.time_left))
		if shown ~= self.clock_shown then
			self.clock_shown = shown
			msg.post("/game_ui#game_gui", "set_clock", { time = shown })
		end
		if self.time_left <= 0 then
			self.round_over = true
			msg.post("/game_ui#game_gui", "level_win")
		end
	end

	-- ---- adaptive music: cross-fade to the track for the current stress ----
	-- 0-33 calm, 34-66 stress, 67+ psycho
	local ps = office.psychosis
	local target = (ps < 34) and 1 or (ps < 67) and 2 or 3
	for i, m in ipairs(self.music) do
		local want = (i == target) and 1.0 or 0.0
		if m.gain ~= want then
			m.gain = approach(m.gain, want, MUSIC_FADE * dt)
			sound.set_gain(m.url, m.gain)
		end
	end

	local p = self.player
	if not p then return end

	-- ---- movement: accelerate toward a target velocity, brake to a stop ----
	local dirx, diry = 0, 0
	if self.move.left  then dirx = dirx - 1 end
	if self.move.right then dirx = dirx + 1 end
	if self.move.down  then diry = diry - 1 end
	if self.move.up    then diry = diry + 1 end

	-- target velocity (the classic isometric ratio applies to the Y axis only)
	local tvx = dirx * SPEED
	local tvy = diry * SPEED * ISO_RATIO

	-- ramp to max speed (or to a full stop) over ACCEL_TIME seconds
	self.vx = approach(self.vx, tvx, (SPEED / ACCEL_TIME) * dt)
	self.vy = approach(self.vy, tvy, (SPEED * ISO_RATIO / ACCEL_TIME) * dt)

	-- face the direction of horizontal travel (euler.y: 0 = right, 180 = left)
	if self.vx > 0 and self.facing ~= 0 then
		self.facing = 0
		go.set(p.id, "euler.y", 0)
	elseif self.vx < 0 and self.facing ~= 180 then
		self.facing = 180
		go.set(p.id, "euler.y", 180)
	end

	-- movement limits: inside the floor rectangle if known, else the whole room
	local minx, maxx = p.hw, ROOM_W - p.hw
	local miny, maxy = p.hh, ROOM_H - p.hh
	if self.floor then
		minx = self.floor.x - self.floor.hw + p.hw
		maxx = self.floor.x + self.floor.hw - p.hw
		miny = self.floor.y - self.floor.hh + p.hh
		maxy = self.floor.y + self.floor.hh - p.hh
	end

	-- move per-axis (so the player slides along walls); a blocked axis stops
	local oldx, oldy = p.x, p.y
	if self.vx ~= 0 then
		local nx = math.max(minx, math.min(maxx, p.x + self.vx * dt))
		if is_free(self, nx, p.y) then p.x = nx else self.vx = 0 end
	end
	if self.vy ~= 0 then
		local ny = math.max(miny, math.min(maxy, p.y + self.vy * dt))
		if is_free(self, p.x, ny) then p.y = ny else self.vy = 0 end
	end

	-- report walking (actually moved) vs standing so the assistant can switch
	-- between its walk and idle animations (position-based, so pushing into a
	-- wall reads as standing rather than flickering)
	local moving = (math.abs(p.x - oldx) + math.abs(p.y - oldy)) > 0.1
	if moving ~= self.last_moving then
		self.last_moving = moving
		msg.post(msg.url(nil, p.id, "script"), "set_moving", { moving = moving })
	end

	-- fake-isometric depth: the assistant's Z follows its Y, like every object
	go.set_position(vmath.vector3(p.x, p.y, office.z_for_y(p.y)), p.id)

	-- ---- desk timers: request patience -> timeout, and post-request cooldown ----
	for _, d in ipairs(self.desks) do
		if d.active then
			d.wait = d.wait - dt
			if d.wait <= 0 then
				-- patience ran out: add a one-time psychosis hit, drop the request
				-- and start the same cooldown as a fulfilled one (no reward, no
				-- delivery anim/sound, no alarm -- just a grunt on the desk side).
				office.psychosis = math.min(100, office.psychosis + (self.miss[d.want] or 0))
				d.active   = false
				d.ready    = false
				d.cooldown = self.cooldown[d.want] or 0
				msg.post(msg.url(nil, d.id, "script"), "timed_out")
				if office.psychosis ~= self.psychosis_shown then
					self.psychosis_shown = office.psychosis
					msg.post("/game_ui#game_gui", "stress", { value = office.psychosis })
				end
			end
		elseif not d.ready then
			d.cooldown = d.cooldown - dt
			if d.cooldown <= 0 then d.ready = true end
		end
	end

	-- ---- request pacing: try to raise a new request every ChekFrequency ----
	self.check_timer = self.check_timer - dt
	if self.check_timer <= 0 then
		self.check_timer = (self.ChekFrequency > 0) and self.ChekFrequency or 1.0
		try_new_request(self)
	end

	-- ---- pick up items from sources (only one type at a time) ----
	for _, s in ipairs(self.sources) do
		if touching(self, s) then
			-- refill this type to its limit; a different held type is dropped.
			-- only fire the pickup sound on a real change (not every frame we
			-- keep standing on the source).
			if self.carry_type ~= s.item or self.carry_count ~= s.max then
				self.carry_type  = s.item
				self.carry_count = s.max
				msg.post(msg.url(nil, p.id, "script"), "play_pickup", { type = s.item })
			end
		end
	end

	-- ---- deliver to a worker who wants exactly what we carry ----
	for _, d in ipairs(self.desks) do
		if d.active and self.carry_type == d.want and self.carry_count > 0 and touching(self, d) then
			self.carry_count = self.carry_count - 1
			if self.carry_count <= 0 then
				self.carry_type = nil
			end
			-- request satisfied: start the type cooldown
			d.active   = false
			d.ready    = false
			d.cooldown = self.cooldown[d.want] or 0
			msg.post(msg.url(nil, d.id, "script"), "fulfilled", { type = d.want })
		end
	end

	-- ---- carry HUD (only when it changes) ----
	if self.carry_type ~= self.last_carry_type or self.carry_count ~= self.last_carry_count then
		self.last_carry_type  = self.carry_type
		self.last_carry_count = self.carry_count
		msg.post(msg.url(nil, p.id, "script"), "set_carry", {
			type  = self.carry_type or hash("none"),
			count = self.carry_count,
		})
	end
end

function on_input(self, action_id, action)
	if action_id == nil then return end
	if action.pressed then
		if     action_id == hash("up")    then self.move.up = true
		elseif action_id == hash("down")  then self.move.down = true
		elseif action_id == hash("left")  then self.move.left = true
		elseif action_id == hash("right") then self.move.right = true end
	elseif action.released then
		if     action_id == hash("up")    then self.move.up = false
		elseif action_id == hash("down")  then self.move.down = false
		elseif action_id == hash("left")  then self.move.left = false
		elseif action_id == hash("right") then self.move.right = false end
	end
end
