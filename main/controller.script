--------------------------------------------------------------------------------
-- controller.script
--
-- The single "brain" of a level. Every playable object (player, desks, item
-- sources, obstacles) is a hand-placed instance in the .collection that
-- registers itself here at load time, so objects can be freely added / removed /
-- moved / resized in the editor -- nothing is created at runtime.
--
-- Each object's collision rectangle IS its sprite: its footprint is read as
-- (sprite size x instance scale), so resizing the coloured square on the field
-- changes the collision box to match.
--
-- Items: the assistant can carry only ONE type at a time. Touching a source
-- refills that type to its limit and drops whatever else was held. A worker
-- wants exactly one item type (chosen by that desk's weights) and is only
-- satisfied by that type.
--
-- Requests / psychosis (see the block comments below the constants) drive the
-- pacing of the level.
--------------------------------------------------------------------------------

local items = require("main.items")

-- how many requests may be active at once. No new request is created while the
-- active count is at this cap.
go.property("MaxActiveRequests", 3)
-- how often (seconds) the controller tries to hand out a new request.
go.property("ChekFrequency", 1.0)

local SPEED         = 320      -- horizontal pixels / second
local ISO_RATIO     = 0.58     -- classic isometric height/width; movement only
local CONTACT_PAD   = 8        -- how close counts as "touching" for interactions

local ROOM_W        = 1920
local ROOM_H        = 1080

-- When a request appears, the worker will wait patiently for this many seconds
-- (random in the range for the requested type). After that the request stays
-- active but the desk starts raising the level psychosis.
local WAIT_RANGE = {
	[items.COFFEE] = { 5, 10 },
	[items.PAPER]  = { 15, 20 },
	[items.CAT]    = { 8, 13 },
}

-- After a request is fulfilled the desk waits this cooldown (seconds, by the
-- delivered type) before it re-joins the pool of desks able to request again.
local COOLDOWN = {
	[items.COFFEE] = 3,
	[items.PAPER]  = 5,
	[items.CAT]    = 8,
}

-- Each desk whose wait time has expired (but is still undelivered) adds this
-- many psychosis percent per minute. Psychosis is clamped to 0..100.
local PSYCHOSIS_PER_MIN = 1.0

--------------------------------------------------------------------------------

local function rand_range(range)
	return range[1] + math.random() * (range[2] - range[1])
end

-- pick an item type from relative weights {coffee, paper, cats}
local function weighted_pick(w)
	local total = (w.coffee or 0) + (w.paper or 0) + (w.cats or 0)
	if total <= 0 then return items.COFFEE end   -- fallback for a mis-configured desk
	local r = math.random() * total
	if r < w.coffee then return items.COFFEE end
	r = r - w.coffee
	if r < w.paper then return items.PAPER end
	return items.CAT
end

-- AABB overlap: centres + half-extents
local function aabb(ax, ay, ahw, ahh, bx, by, bhw, bhh)
	return math.abs(ax - bx) < (ahw + bhw) and math.abs(ay - by) < (ahh + bhh)
end

-- can the player centre sit at (px, py) without entering any solid?
local function is_free(self, px, py)
	local p = self.player
	for _, s in ipairs(self.solids) do
		if aabb(px, py, p.hw, p.hh, s.x, s.y, s.hw, s.hh) then
			return false
		end
	end
	return true
end

-- is the (inflated) player touching box b?
local function touching(self, b)
	local p = self.player
	return aabb(p.x, p.y, p.hw + CONTACT_PAD, p.hh + CONTACT_PAD, b.x, b.y, b.hw, b.hh)
end

-- number of desks that currently have an undelivered request
local function count_active(self)
	local n = 0
	for _, d in ipairs(self.desks) do
		if d.active then n = n + 1 end
	end
	return n
end

-- desks ready to request again, in random order (Fisher-Yates shuffle)
local function shuffled_ready(self)
	local list = {}
	for _, d in ipairs(self.desks) do
		if d.ready then list[#list + 1] = d end
	end
	for i = #list, 2, -1 do
		local j = math.random(i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- hand a fresh request to desk d
local function give_request(self, d)
	d.active  = true
	d.ready   = false
	d.want    = weighted_pick(d.w)
	d.wait    = rand_range(WAIT_RANGE[d.want])
	d.expired = false
	msg.post(msg.url(nil, d.id, "script"), "show_icon", { type = d.want })
end

-- once per ChekFrequency: maybe promote ONE ready desk to a new request
local function try_new_request(self)
	local maxreq = self.MaxActiveRequests
	if maxreq <= 0 then return end

	local active = count_active(self)
	if active >= maxreq then return end          -- never exceed the cap

	-- probability that a checked desk raises a request this pass
	local prob = 1 - (active / maxreq)
	if prob <= 0 then return end

	for _, d in ipairs(shuffled_ready(self)) do
		if math.random() < prob then
			give_request(self, d)
			return                               -- one request per check, then stop
		end
	end
end

--------------------------------------------------------------------------------

function init(self)
	msg.post(".", "acquire_input_focus")
	math.randomseed(os.time())
	math.random(); math.random()

	self.move             = { up = false, down = false, left = false, right = false }
	self.carry_type       = nil    -- item type currently held (hash) or nil
	self.carry_count      = 0
	self.last_carry_type  = false   -- forces a first HUD refresh
	self.last_carry_count = -1

	self.solids   = {}   -- everything the player cannot pass through
	self.desks    = {}   -- desks (subset of solids) with request state
	self.sources  = {}   -- item sources (subset of solids): coffee/paper/cat
	self.player   = nil  -- filled in when the player registers

	-- level-wide psychosis meter (0..100), raised by impatient workers
	self.psychosis = 0
	self.psychosis_shown = 0

	-- request pacing
	self.check_timer = self.ChekFrequency
end

function on_message(self, message_id, message, sender)
	if message_id ~= hash("register") then return end

	local box = {
		id = message.id,
		x = message.x, y = message.y, z = message.z,
		hw = message.hw, hh = message.hh,
	}
	local kind = message.kind

	if kind == hash("player") then
		self.player = box
	elseif kind == hash("desk") then
		-- every desk starts idle and ready to request (zero cooldown)
		box.active   = false
		box.want     = nil
		box.wait     = 0
		box.expired  = false
		box.cooldown = 0
		box.ready    = true
		box.w = { coffee = message.w_coffee, paper = message.w_paper, cats = message.w_cats }
		table.insert(self.desks, box)
		table.insert(self.solids, box)
	elseif items.MAX[kind] then
		-- a source: kind is the item type it dispenses (coffee / paper / cat)
		box.item = kind
		box.max  = items.MAX[kind]
		table.insert(self.sources, box)
		table.insert(self.solids, box)
	else
		-- plain obstacle
		table.insert(self.solids, box)
	end
end

function update(self, dt)
	local p = self.player
	if not p then return end

	-- ---- movement (per-axis so the player can slide along walls) ----
	local dx, dy = 0, 0
	if self.move.left  then dx = dx - 1 end
	if self.move.right then dx = dx + 1 end
	if self.move.down  then dy = dy - 1 end
	if self.move.up    then dy = dy + 1 end

	-- the classic isometric ratio applies to movement only: the vertical
	-- (screen y) axis moves at 0.58x the horizontal speed.
	local step_x = dx * SPEED * dt
	local step_y = dy * SPEED * ISO_RATIO * dt

	if step_x ~= 0 then
		local nx = math.max(p.hw, math.min(ROOM_W - p.hw, p.x + step_x))
		if is_free(self, nx, p.y) then p.x = nx end
	end
	if step_y ~= 0 then
		local ny = math.max(p.hh, math.min(ROOM_H - p.hh, p.y + step_y))
		if is_free(self, p.x, ny) then p.y = ny end
	end

	go.set_position(vmath.vector3(p.x, p.y, p.z), p.id)

	-- ---- desk timers: wait -> expiry (psychosis), and post-delivery cooldown ----
	local expired = 0
	for _, d in ipairs(self.desks) do
		if d.active then
			if not d.expired then
				d.wait = d.wait - dt
				if d.wait <= 0 then d.expired = true end
			end
			if d.expired then expired = expired + 1 end
		elseif not d.ready then
			d.cooldown = d.cooldown - dt
			if d.cooldown <= 0 then d.ready = true end
		end
	end

	-- ---- psychosis: every impatient (expired) desk raises the level meter ----
	if expired > 0 then
		self.psychosis = math.min(100, self.psychosis + expired * (PSYCHOSIS_PER_MIN / 60) * dt)
		local whole = math.floor(self.psychosis)
		if whole ~= self.psychosis_shown then
			self.psychosis_shown = whole
			-- push the new stress value to the in-game HUD
			msg.post("/game_ui#game_gui", "stress", { value = self.psychosis })
		end
	end

	-- ---- request pacing: try to raise a new request every ChekFrequency ----
	self.check_timer = self.check_timer - dt
	if self.check_timer <= 0 then
		self.check_timer = (self.ChekFrequency > 0) and self.ChekFrequency or 1.0
		try_new_request(self)
	end

	-- ---- pick up items from sources (only one type at a time) ----
	for _, s in ipairs(self.sources) do
		if touching(self, s) then
			-- refill this type to its limit; a different held type is dropped.
			-- only fire the pickup sound on a real change (not every frame we
			-- keep standing on the source).
			if self.carry_type ~= s.item or self.carry_count ~= s.max then
				self.carry_type  = s.item
				self.carry_count = s.max
				msg.post(msg.url(nil, p.id, "script"), "play_pickup", { type = s.item })
			end
		end
	end

	-- ---- deliver to a worker who wants exactly what we carry ----
	for _, d in ipairs(self.desks) do
		if d.active and self.carry_type == d.want and self.carry_count > 0 and touching(self, d) then
			self.carry_count = self.carry_count - 1
			if self.carry_count <= 0 then
				self.carry_type = nil
			end
			-- request satisfied: stop raising psychosis, start the type cooldown
			d.active   = false
			d.expired  = false
			d.ready    = false
			d.cooldown = COOLDOWN[d.want] or 0
			msg.post(msg.url(nil, d.id, "script"), "fulfilled", { type = d.want })
		end
	end

	-- ---- carry HUD (only when it changes) ----
	if self.carry_type ~= self.last_carry_type or self.carry_count ~= self.last_carry_count then
		self.last_carry_type  = self.carry_type
		self.last_carry_count = self.carry_count
		msg.post(msg.url(nil, p.id, "script"), "set_carry", {
			type  = self.carry_type or hash("none"),
			count = self.carry_count,
		})
	end
end

function on_input(self, action_id, action)
	if action_id == nil then return end
	if action.pressed then
		if     action_id == hash("up")    then self.move.up = true
		elseif action_id == hash("down")  then self.move.down = true
		elseif action_id == hash("left")  then self.move.left = true
		elseif action_id == hash("right") then self.move.right = true end
	elseif action.released then
		if     action_id == hash("up")    then self.move.up = false
		elseif action_id == hash("down")  then self.move.down = false
		elseif action_id == hash("left")  then self.move.left = false
		elseif action_id == hash("right") then self.move.right = false end
	end
end
