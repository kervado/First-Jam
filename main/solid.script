--------------------------------------------------------------------------------
-- solid.script
--
-- Shared by every "dumb" static object. The `kind` property (set per .go)
-- decides its colour and how it registers with the controller:
--   obstacle -> grey, blocks the player
--   floor    -> dark, purely decorative (walkable, not registered)
--   coffee   -> brown coffee machine  (blocks + gives coffee on contact)
--   paper    -> beige paper cabinet   (blocks + gives paper on contact)
--   cat      -> purple cat house      (blocks + gives a cat on contact)
--
-- Source behaviour (coffee/paper/cat) lives in the controller, which knows the
-- carry limit for each item type. This script only draws the body and reports
-- its footprint: (sprite size x instance scale), so resizing the coloured
-- square on the field resizes the collision box.
--------------------------------------------------------------------------------

go.property("kind", hash("obstacle"))

local CONTROLLER = "controller#controller"

local BODY = {
	[hash("obstacle")] = vmath.vector4(0.40, 0.40, 0.46, 1.0),
	[hash("floor")]    = vmath.vector4(0.12, 0.14, 0.13, 1.0),
	[hash("coffee")]   = vmath.vector4(0.62, 0.36, 0.14, 1.0),
	[hash("paper")]    = vmath.vector4(0.85, 0.78, 0.55, 1.0),
	[hash("cat")]      = vmath.vector4(0.55, 0.40, 0.70, 1.0),
}

function init(self)
	go.set("#sprite", "tint", BODY[self.kind] or vmath.vector4(1, 1, 1, 1))

	-- the floor is walkable: it colours itself but never registers as a solid
	if self.kind == hash("floor") then
		return
	end

	local size  = go.get("#sprite", "size")   -- base sprite size (unscaled)
	local scale = go.get_scale()               -- per-instance scale
	local pos   = go.get_position()

	msg.post(CONTROLLER, "register", {
		kind = self.kind,
		id   = go.get_id(),
		x = pos.x, y = pos.y, z = pos.z,
		hw = 0.5 * size.x * scale.x,
		hh = 0.5 * size.y * scale.y,
	})
end
