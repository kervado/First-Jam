--------------------------------------------------------------------------------
-- player.script
--
-- The assistant. It does not move itself: the controller owns movement,
-- collision and the carried-item state. This script registers the player and
-- displays what it is currently carrying above its head: one coloured icon for
-- the item type plus a number for how many are held.
--------------------------------------------------------------------------------

local items = require("main.items")

local CONTROLLER = "controller#controller"
local C_PLAYER = vmath.vector4(0.25, 0.82, 0.38, 1.0)   -- green assistant

-- sound played when the assistant picks up a given item type from a source
local PICKUP_SOUND = {
	[items.COFFEE] = "#snd_coffee",   -- coffee-pouring.wav
	[items.PAPER]  = "#snd_paper",    -- paper-rustle.wav
	[items.CAT]    = "#snd_cat",      -- cat-meow.wav
}

function init(self)
	go.set("#sprite", "tint", C_PLAYER)
	msg.post("#icon", "disable")    -- carry indicator hidden until we hold something
	msg.post("#count", "disable")

	local size  = go.get("#sprite", "size")
	local scale = go.get_scale()
	local pos   = go.get_position()

	msg.post(CONTROLLER, "register", {
		kind = hash("player"),
		id   = go.get_id(),
		x = pos.x, y = pos.y, z = pos.z,
		hw = 0.5 * size.x * scale.x,
		hh = 0.5 * size.y * scale.y,
	})
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_carry") then
		local color = items.COLORS[message.type]   -- nil when carrying nothing
		if color and message.count > 0 then
			go.set("#icon", "tint", color)
			label.set_text("#count", tostring(message.count))
			msg.post("#icon", "enable")
			msg.post("#count", "enable")
		else
			msg.post("#icon", "disable")
			msg.post("#count", "disable")
		end
	elseif message_id == hash("play_pickup") then
		local snd = PICKUP_SOUND[message.type]
		if snd then
			msg.post(snd, "stop_sound")
			msg.post(snd, "play_sound")
		end
	end
end
