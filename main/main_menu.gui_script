-- Main menu: gray items on a black screen. Hovering an item highlights it
-- with a thin frame, a red square marker and white text (mockup style).
-- Holding the left mouse button grows the label a bit; releasing over the
-- same item counts as a click.

local COLOR_IDLE  = vmath.vector4(0.5, 0.5, 0.5, 1.0) -- default gray label
local COLOR_HOVER = vmath.vector4(1.0, 1.0, 1.0, 1.0) -- white label on hover

local SCALE_NORMAL  = vmath.vector3(1.0, 1.0, 1.0)
local SCALE_PRESSED = vmath.vector3(1.12, 1.12, 1.0)  -- label grows while held

local function quit_game()
	msg.post("@system:", "exit", { code = 0 })
end

-- on_click fires on release over the same item. Items without a handler still
-- highlight on hover but do nothing yet.
local ITEMS = {
	{ prefix = "new" },
	{ prefix = "settings" },
	{ prefix = "diary" },
	{ prefix = "exit", on_click = quit_game },
}

local function set_highlight(btn, on)
	gui.set_color(btn.text, on and COLOR_HOVER or COLOR_IDLE)
	gui.set_enabled(btn.frame, on)
	gui.set_enabled(btn.inner, on)
	gui.set_enabled(btn.marker, on)
end

function init(self)
	msg.post(".", "acquire_input_focus")

	self.buttons = {}
	for i, def in ipairs(ITEMS) do
		local btn = {
			hit = gui.get_node(def.prefix .. "_hit"),
			frame = gui.get_node(def.prefix .. "_frame"),
			inner = gui.get_node(def.prefix .. "_inner"),
			marker = gui.get_node(def.prefix .. "_marker"),
			text = gui.get_node(def.prefix .. "_text"),
			on_click = def.on_click,
			hovered = false,
			pressed = false,
		}
		self.buttons[i] = btn
		set_highlight(btn, false)
		gui.set_scale(btn.text, SCALE_NORMAL)
	end
end

function on_input(self, action_id, action)
	-- Mouse movement arrives with action_id == nil; use every pointer action
	-- to refresh the hover state against the invisible hit boxes.
	for _, btn in ipairs(self.buttons) do
		btn.hovered = gui.pick_node(btn.hit, action.x, action.y)
		set_highlight(btn, btn.hovered)
	end

	if action_id ~= hash("touch") then
		return
	end

	if action.pressed then
		for _, btn in ipairs(self.buttons) do
			if btn.hovered then
				btn.pressed = true
				gui.set_scale(btn.text, SCALE_PRESSED) -- label grows
			end
		end
	elseif action.released then
		for _, btn in ipairs(self.buttons) do
			if btn.pressed then
				btn.pressed = false
				gui.set_scale(btn.text, SCALE_NORMAL) -- label back to normal
				-- a click = pressed and released over the same item
				if btn.hovered and btn.on_click then
					btn.on_click()
				end
			end
		end
	end
end
