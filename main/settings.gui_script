-- Settings screen. Controls:
--  * full_screen_checkbox (image button) -> toggles fullscreen; the "check"
--    overlay is shown when fullscreen is on. Images: checkbox/_focus/_down.
--  * volume slider (sl_handle) -> mouse wheel or drag; position mirrors the
--    global SETTINGS.volume (0..1). No fill bar / percentage anymore.
--  * back_button (image button) -> leave settings. Images: button_close/_focus/_down.
--  * menu (text, game only) -> quit the game to the menu. Hover: text -> #DB5200
--    and the menu_marker icon shows.
-- Everything is applied live and saved via settings_store.

local store = require("main.settings_store")

local MENU_HOVER = vmath.vector4(0.858824, 0.321569, 0.0, 1.0) -- #DB5200

local VOLUME_STEP = 0.05

local HOVER_SOUND = "#hover_sound"
local CLICK_SOUND = "#touch_icon_sound"

local function play_hover()
	msg.post(HOVER_SOUND, "stop_sound")
	msg.post(HOVER_SOUND, "play_sound")
end

local function play_click()
	msg.post(CLICK_SOUND, "stop_sound")
	msg.post(CLICK_SOUND, "play_sound")
end

local function clamp01(v)
	if v < 0 then return 0 end
	if v > 1 then return 1 end
	return v
end

-- swap a node's atlas image, only when it changes
local function set_img(self, key, node, img)
	if self[key] ~= img then
		self[key] = img
		gui.play_flipbook(node, hash(img))
	end
end

-- pick the focus/down/idle image name for an image button
local function img_name(base, hovered, pressed)
	if pressed and hovered then return base .. "_down" end
	if hovered then return base .. "_focus" end
	return base
end

local function update_slider(self)
	local x = self.track_x + self.track_w * SETTINGS.volume
	gui.set_position(self.sl_handle, vmath.vector3(x, self.track_y, 0))
end

local function set_volume(self, v)
	SETTINGS.volume = clamp01(v)
	if sound and sound.set_group_gain then
		sound.set_group_gain(hash("master"), SETTINGS.volume)
	end
	update_slider(self)
end

local function toggle_fullscreen(self)
	SETTINGS.fullscreen = not SETTINGS.fullscreen
	if defos and defos.set_fullscreen then
		defos.set_fullscreen(SETTINGS.fullscreen)
	end
	gui.set_enabled(self.check, SETTINGS.fullscreen)
	store.save(SETTINGS)
end

local function set_active(self, on)
	self.active = on
	self.dragging = false
	gui.set_enabled(self.root, on)
	if on then
		gui.set_enabled(self.check, SETTINGS.fullscreen)
		update_slider(self)
	else
		-- reset interactive visuals so nothing lingers on the next open
		for _, b in ipairs(self.imgbtns) do
			b.hovered, b.pressed = false, false
			set_img(self, b.key, b.node, b.base)
		end
		self.menu_hovered, self.menu_pressed = false, false
		gui.set_color(self.menu_text, self.menu_idle)
		gui.set_enabled(self.menu_marker, false)
	end
end

-- "back": from the game -> return to the game; from the menu -> back to the menu.
local function go_back(self)
	set_active(self, false)
	if self.from == "game" then
		msg.post("/game_ui#game_gui", "game_ui_show")
	else
		msg.post("/menu#menu", "show_menu")
	end
end

-- "menu" (only shown when opened from the game): close the game and open the menu.
local function go_to_menu(self)
	set_active(self, false)
	msg.post("main:/menu#menu", "return_to_menu")
end

-- show/hide the game-only "menu" text button
local function apply_source(self)
	local visible = self.from == "game"
	self.menu_hidden = not visible
	gui.set_enabled(self.menu_text, visible)
	if not visible then
		self.menu_hovered, self.menu_pressed = false, false
		gui.set_enabled(self.menu_marker, false)
		gui.set_color(self.menu_text, self.menu_idle)
	end
end

function init(self)
	if not SETTINGS then
		SETTINGS = store.load()
	end

	self.root = gui.get_node("root")
	self.check = gui.get_node("check")
	self.sl_hit = gui.get_node("sl_hit")
	self.sl_handle = gui.get_node("sl_handle")
	self.sl_p0 = gui.get_node("sl_p0")
	self.sl_p1 = gui.get_node("sl_p1")
	self.menu_text = gui.get_node("menu_text")
	self.menu_marker = gui.get_node("menu_marker")
	self.menu_idle = gui.get_color(self.menu_text)

	-- read slider geometry from the gui so editor changes need no script change
	self.track_x = gui.get_position(self.sl_p0).x
	self.track_w = gui.get_position(self.sl_p1).x - self.track_x
	self.track_y = gui.get_position(self.sl_handle).y

	-- image buttons (checkbox + close)
	self.imgbtns = {
		{ node = gui.get_node("full_screen_checkbox"), base = "checkbox",     key = "cb_img",   on_click = toggle_fullscreen },
		{ node = gui.get_node("back_button"),          base = "button_close", key = "back_img", on_click = go_back },
	}
	for _, b in ipairs(self.imgbtns) do
		b.hovered, b.pressed = false, false
		set_img(self, b.key, b.node, b.base)
	end

	self.from = "menu"
	self.active = false
	self.dragging = false
	self.menu_hovered, self.menu_pressed = false, false
	apply_source(self)

	msg.post(".", "acquire_input_focus")
	gui.set_enabled(self.root, false) -- start hidden until menu/game asks to show
end

function on_message(self, message_id, message, sender)
	if message_id == hash("show") then
		self.from = (message and message.from) or "menu"
		set_active(self, true)
		apply_source(self)
	end
end

-- screen-space slider value (works on any resolution / aspect / DPI)
local function volume_at(self, action)
	local sx = action.screen_x or action.x
	local x0 = gui.get_screen_position(self.sl_p0).x
	local x1 = gui.get_screen_position(self.sl_p1).x
	if x1 == x0 then
		return SETTINGS.volume
	end
	return clamp01((sx - x0) / (x1 - x0))
end

function on_input(self, action_id, action)
	if not self.active then
		return
	end
	if action.x == nil then
		return -- key actions have no cursor position
	end

	-- hover: image buttons
	for _, b in ipairs(self.imgbtns) do
		local h = gui.pick_node(b.node, action.x, action.y)
		if h and not b.hovered then play_hover() end
		b.hovered = h
	end
	-- hover: menu text button (game only)
	if not self.menu_hidden then
		local h = gui.pick_node(self.menu_text, action.x, action.y)
		if h and not self.menu_hovered then play_hover() end
		self.menu_hovered = h
		gui.set_color(self.menu_text, h and MENU_HOVER or self.menu_idle)
		gui.set_enabled(self.menu_marker, h)
	end

	-- dragging the slider
	if self.dragging then
		set_volume(self, volume_at(self, action))
	end

	if action_id == hash("wheel_up") and action.pressed then
		set_volume(self, SETTINGS.volume + VOLUME_STEP)
		store.save(SETTINGS)
	elseif action_id == hash("wheel_down") and action.pressed then
		set_volume(self, SETTINGS.volume - VOLUME_STEP)
		store.save(SETTINGS)
	elseif action_id == hash("touch") then
		if action.pressed then
			if gui.pick_node(self.sl_hit, action.x, action.y) then
				self.dragging = true
				set_volume(self, volume_at(self, action))
			else
				local hit = false
				for _, b in ipairs(self.imgbtns) do
					if b.hovered then b.pressed = true; hit = true end
				end
				if not self.menu_hidden and self.menu_hovered then
					self.menu_pressed = true; hit = true
				end
				if hit then play_click() end
			end
		elseif action.released then
			if self.dragging then
				self.dragging = false
				store.save(SETTINGS) -- persist the final slider value once
			end
			for _, b in ipairs(self.imgbtns) do
				if b.pressed then
					b.pressed = false
					if b.hovered then b.on_click(self) end
				end
			end
			if self.menu_pressed then
				self.menu_pressed = false
				if self.menu_hovered then go_to_menu(self) end
			end
		end
	end

	-- refresh image-button textures (focus/down/idle)
	for _, b in ipairs(self.imgbtns) do
		set_img(self, b.key, b.node, img_name(b.base, b.hovered, b.pressed))
	end
end
