-- In-game HUD:
--  * gear button (btn)      -> opens settings (and pauses)
--  * pause button (btn_pauze) / Space -> toggles pause
--  * stress bar + chaos-level face
-- Pausing freezes the whole game collection (proxy time step = 0) and pauses the
-- office ambience. Settings living in this collection stays responsive because
-- it is input-driven, not update-driven.

local COLOR_IDLE  = vmath.vector4(0.16, 0.16, 0.20, 0.90)
local COLOR_HOVER = vmath.vector4(0.30, 0.30, 0.38, 0.95)

local GAME_PROXY = "main:/menu#gameproxy"   -- the collectionproxy that hosts this level
local AMBIENCE   = "/controller#ambience"   -- looping office ambience sound

local function set_button(self, on)
	self.active = on
	gui.set_enabled(self.btn, on) -- disabling the button hides its icon too
end

-- Freeze/unfreeze the level and its background music, and flip the button icon
-- (pause bars ln3/ln4 while running, play triangle while paused).
local function set_paused(self, paused)
	if self.paused == paused then
		return
	end
	self.paused = paused
	msg.post(GAME_PROXY, "set_time_step", { factor = paused and 0 or 1, mode = 0 })
	sound.pause(AMBIENCE, paused)
	gui.set_enabled(self.ln3, not paused)
	gui.set_enabled(self.ln4, not paused)
	gui.set_enabled(self.play, paused)
end

-- Chaos level -> smile_stress face, by office stress (0..100):
-- 0-29 NORMAL, 30-59 TENSION, 60-79 CHAOS, 80-99 CRITICAL, 100 FAILURE
local function chaos_face(value)
	if value < 30 then return "emoji_normal"
	elseif value < 60 then return "emoji_tension"
	elseif value < 80 then return "emoji_chaos"
	elseif value < 100 then return "emoji_critical"
	else return "emoji_failure" end
end

local function set_stress(self, value)
	value = math.max(0, math.min(100, value or 0))
	gui.set_text(self.text_stress, string.format("%d%%", math.floor(value + 0.5)))

	local p = gui.get_position(self.level_stress)
	p.x = self.stress_w * value / 100 -- slide the fill by x
	gui.set_position(self.level_stress, p)

	-- gradient: 0 = green, 50 = yellow, 100 = red (keep the node's alpha)
	local r, g
	if value <= 50 then
		r, g = value / 50, 1.0
	else
		r, g = 1.0, 1.0 - (value - 50) / 50
	end
	local c = gui.get_color(self.level_stress)
	c.x, c.y, c.z = r, g, 0.0
	gui.set_color(self.level_stress, c)

	-- swap the chaos-level face only when the tier actually changes
	local face = chaos_face(value)
	if face ~= self.smile_face then
		self.smile_face = face
		pcall(gui.play_flipbook, self.smile_stress, hash(face))
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.btn = gui.get_node("btn")
	self.btn_pauze = gui.get_node("btn_pauze")
	self.ln3 = gui.get_node("ln3")
	self.ln4 = gui.get_node("ln4")
	self.play = gui.get_node("play")
	self.text_stress = gui.get_node("text_stress")
	self.level_stress = gui.get_node("level_stress")
	self.smile_stress = gui.get_node("smile_stress")
	-- read the bar width from the mask node, so resizing base_level in the gui
	-- needs no script change
	self.stress_w = gui.get_size(gui.get_node("base_level")).x

	self.active = true
	self.paused = false
	gui.set_color(self.btn, COLOR_IDLE)
	-- initial icon: running -> pause bars visible, play hidden
	gui.set_enabled(self.ln3, true)
	gui.set_enabled(self.ln4, true)
	gui.set_enabled(self.play, false)
	set_stress(self, 0) -- start empty
end

function on_message(self, message_id, message, sender)
	if message_id == hash("game_ui_show") then
		set_button(self, true)
		gui.set_color(self.btn, COLOR_IDLE)
		set_paused(self, false) -- resume when returning from settings
	elseif message_id == hash("stress") then
		set_stress(self, message.value)
	end
end

function on_input(self, action_id, action)
	if not self.active then
		return
	end

	-- Space toggles pause (key action -> no cursor position)
	if action_id == hash("pause") then
		if action.pressed then
			set_paused(self, not self.paused)
		end
		return true
	end

	if action.x == nil then
		return -- other key actions (WASD/arrows) have no cursor position
	end

	local hover_gear  = gui.pick_node(self.btn, action.x, action.y)
	local hover_pause = gui.pick_node(self.btn_pauze, action.x, action.y)
	gui.set_color(self.btn, hover_gear and COLOR_HOVER or COLOR_IDLE)

	if action_id == hash("touch") then
		if action.released then
			if hover_gear then
				set_button(self, false)                                    -- hide while in settings
				set_paused(self, true)                                     -- pause on entering settings
				msg.post("/settings#settings", "show", { from = "game" })  -- open this collection's settings
			elseif hover_pause then
				set_paused(self, not self.paused)                          -- toggle pause
			end
		end
		if hover_gear or hover_pause then
			return true -- swallow clicks on either button
		end
	end
end
