-- In-game HUD:
--  * gear button (btn)        -> opens settings (image: button_settings/_focus/_down)
--  * pause button (btn_pauze) / Space -> toggles pause (button_pause/_focus/_down)
--  * stress bar (level_stress grows by size.x), chaos-level face, floor + clock
--  * start_banner: shown on floor 1 only; the level is paused until it is
--    dismissed (15s via the menu timer, or a click anywhere).
-- Pausing freezes the level (proxy time step = 0, via the menu) and pauses all
-- looping audio.

-- all looping audio in the level; paused/resumed together with the game
local GAME_SOUNDS = {
	"/controller#ambience",
	"/controller#music_calm",
	"/controller#music_stress",
	"/controller#music_psycho",
}

local STRESS_MAX = 244.0 -- level_stress width (px) at 100% stress

local function fmt_clock(sec)
	sec = math.max(0, math.floor(sec))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

-- swap a node's atlas image, only when it actually changes
local function set_img(self, key, node, img)
	if self[key] ~= img then
		self[key] = img
		gui.play_flipbook(node, hash(img))
	end
end

-- pick the focus/down/idle image name for a button
local function btn_img(base, hovered, pressed)
	if pressed and hovered then return base .. "_down" end
	if hovered then return base .. "_focus" end
	return base
end

local function set_button(self, on)
	self.active = on
	gui.set_enabled(self.btn, on)
	if on then
		set_img(self, "gear_img", self.btn, "button_settings")
	end
end

-- Freeze/unfreeze the level and its audio. The menu owns the current proxy, so
-- it applies the time step.
local function set_paused(self, paused)
	if self.paused == paused then
		return
	end
	self.paused = paused
	msg.post("main:/menu#menu", "set_game_paused", { paused = paused })
	for _, url in ipairs(GAME_SOUNDS) do
		sound.pause(url, paused)
	end
	-- while paused the button shows "play", otherwise "pause"
	set_img(self, "pause_img", self.btn_pauze, paused and "button_play" or "button_pause")
end

local function game_over(self)
	if self.finished then
		return
	end
	self.finished = true
	self.result = "lose"
	set_paused(self, true)
	gui.set_text(self.text_finish, "ВЫ УВОЛЕНЫ")
	gui.set_enabled(self.shadow, true)
	msg.post("main:/menu#menu", "begin_finish")
end

local function win_level(self)
	if self.finished then
		return
	end
	self.finished = true
	self.result = "win"
	set_paused(self, true)
	gui.set_text(self.text_finish, "УРОВЕНЬ ПРОЙДЕН")
	gui.set_enabled(self.shadow, true)
	msg.post("main:/menu#menu", "level_complete")
end

-- Hide the start banner and resume play (floor 1 only).
local function dismiss_banner(self)
	if not self.banner_active then
		return
	end
	self.banner_active = false
	gui.set_enabled(self.start_banner, false)
	set_paused(self, false)
	msg.post("main:/menu#menu", "cancel_banner") -- stop the 15s auto-dismiss
end

-- Chaos level -> smile_stress face, by office stress (0..100).
local function chaos_face(value)
	if value < 30 then return "emoji_normal"
	elseif value < 60 then return "emoji_tension"
	elseif value < 80 then return "emoji_chaos"
	elseif value < 100 then return "emoji_critical"
	else return "emoji_failure" end
end

local function set_stress(self, value)
	value = math.max(0, math.min(100, value or 0))
	gui.set_text(self.text_stress, string.format("%d%%", math.floor(value + 0.5)))

	-- grow the fill by size.x (0 .. STRESS_MAX)
	local sz = gui.get_size(self.level_stress)
	sz.x = STRESS_MAX * value / 100
	gui.set_size(self.level_stress, sz)

	local face = chaos_face(value)
	if face ~= self.smile_face then
		self.smile_face = face
		pcall(gui.play_flipbook, self.smile_stress, hash(face))
	end

	if value >= 100 then
		game_over(self)
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.btn = gui.get_node("btn")
	self.btn_pauze = gui.get_node("btn_pauze")
	self.text_stress = gui.get_node("text_stress")
	self.level_stress = gui.get_node("level_stress")
	self.smile_stress = gui.get_node("smile_stress")
	self.shadow = gui.get_node("shadow")
	self.text_finish = gui.get_node("text_finish")
	self.text_floor = gui.get_node("text_floor")
	self.text_clock = gui.get_node("text_clock")
	self.start_banner = gui.get_node("start_banner")

	self.active = true
	self.paused = false
	self.finished = false
	self.banner_active = false
	self.gear_pressed = false
	self.pause_pressed = false

	gui.set_enabled(self.shadow, false)
	gui.set_enabled(self.start_banner, false)
	set_img(self, "gear_img", self.btn, "button_settings")
	set_img(self, "pause_img", self.btn_pauze, "button_pause")
	set_stress(self, 0)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("game_ui_show") then
		set_button(self, true)
		set_paused(self, false) -- resume when returning from settings
	elseif message_id == hash("stress") then
		set_stress(self, message.value)
	elseif message_id == hash("set_floor") then
		gui.set_text(self.text_floor, string.format("%d", message.floor))
		if message.floor == 1 then
			-- first floor: show the start banner and pause until dismissed
			self.banner_active = true
			gui.set_enabled(self.start_banner, true)
			set_paused(self, true)
			msg.post("main:/menu#menu", "begin_banner")
		end
	elseif message_id == hash("set_clock") then
		gui.set_text(self.text_clock, fmt_clock(message.time))
	elseif message_id == hash("level_win") then
		win_level(self)
	elseif message_id == hash("banner_timeout") then
		dismiss_banner(self)
	end
end

function on_input(self, action_id, action)
	if not self.active then
		return
	end

	-- start banner: a click (or the menu's 15s timer) dismisses it; block the
	-- rest of the input while it is up
	if self.banner_active then
		if action_id == hash("touch") and action.pressed then
			dismiss_banner(self)
		end
		return true
	end

	-- finished: on a LOSS a left click returns to the menu; on a WIN the menu
	-- advances on its own timer
	if self.finished then
		if self.result == "lose" and action_id == hash("touch") and action.pressed then
			msg.post("main:/menu#menu", "return_to_menu")
		end
		return true
	end

	-- Space toggles pause
	if action_id == hash("pause") then
		if action.pressed then
			set_paused(self, not self.paused)
		end
		return true
	end

	-- Esc opens settings (same as clicking the gear)
	if action_id == hash("escape") then
		if action.pressed then
			set_button(self, false)                                    -- hide gear while in settings
			set_paused(self, true)                                     -- pause on entering settings
			msg.post("/settings#settings", "show", { from = "game" })
		end
		return true
	end

	if action.x == nil then
		return -- other key actions (WASD/arrows) have no cursor position
	end

	local hg = gui.pick_node(self.btn, action.x, action.y)
	local hp = gui.pick_node(self.btn_pauze, action.x, action.y)

	if action_id == hash("touch") then
		if action.pressed then
			if hg then self.gear_pressed = true end
			if hp then self.pause_pressed = true end
		elseif action.released then
			if self.gear_pressed and hg then
				set_button(self, false)                                    -- hide gear while in settings
				set_paused(self, true)                                     -- pause on entering settings
				msg.post("/settings#settings", "show", { from = "game" })
			elseif self.pause_pressed and hp then
				set_paused(self, not self.paused)                          -- toggle pause
			end
			self.gear_pressed = false
			self.pause_pressed = false
		end
	end

	-- reflect hover/press on the button images (pause button base depends on state)
	local pause_base = self.paused and "button_play" or "button_pause"
	set_img(self, "gear_img", self.btn, btn_img("button_settings", hg, self.gear_pressed))
	set_img(self, "pause_img", self.btn_pauze, btn_img(pause_base, hp, self.pause_pressed))

	if (hg or hp) and action_id == hash("touch") then
		return true -- swallow clicks on the buttons
	end
end
