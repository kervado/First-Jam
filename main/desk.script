--------------------------------------------------------------------------------
-- desk.script
--
-- A worker's desk. Blocks the player and registers as a "desk". A worker wants
-- exactly one thing at a time; the type is chosen by the controller using the
-- per-desk weights below.
--
-- Request weights (edit per desk in the .go or per instance in the collection):
--   coffee / paper / cats -> relative chance of wanting each item.
--   e.g. coffee=3, paper=2, cats=1  ->  3/6, 2/6, 1/6
--        coffee=3, paper=4, cats=2  ->  3/9, 4/9, 2/9
--   A weight of 0 disables that item for this desk.
--
-- The floating request icon is a SEPARATE game object (so it can bob up and
-- down on its own -- a sprite component's position cannot be moved at runtime).
-- Just make that icon object a CHILD of this desk; it auto-registers here at
-- load (via go.get_parent), so no manual linking is needed. This script only
-- tells it to show the wanted item or hide.
--------------------------------------------------------------------------------

local items = require("main.items")
local office = require("main.office")

local CONTROLLER = "controller#controller"
local TRANSPARENT = vmath.vector4(1.0, 1.0, 1.0, 0.0)

go.property("coffee", 3)
go.property("paper", 2)
go.property("cats", 1)

-- sound played when a request of a given type is fulfilled
local DELIVER_SOUND = {
	[items.COFFEE] = "#snd_coffee",   -- gulp.wav
	[items.PAPER]  = "#snd_paper",    -- laser-printer.wav
	[items.CAT]    = "#snd_cat",      -- cat-purring.wav
}

local function play(url)
	msg.post(url, "stop_sound")
	msg.post(url, "play_sound")
end

-- forward a message to the request-icon object, if one has registered
local function tell_icon(self, message_id, message)
	if self.icon then
		msg.post(self.icon, message_id, message or {})
	end
end

function init(self)
	self.icon = nil   -- set when the child request-icon registers itself
	go.set("#sprite", "tint", TRANSPARENT)   -- body no longer drawn (footprint only)

	-- world-space transform (this desk may be a child of another object)
	local wp    = go.get_world_position()
	local scale = go.get_world_scale()

	-- fake-isometric depth from WORLD Y (same rule as the solid objects)
	local z = office.z_for_y(wp.y)
	office.apply_depth(z)

	-- if this desk is a child of another object, re-apply depth each frame so a
	-- parent that applies its depth after us cannot push our world Z off-screen
	self.reapply_depth = go.get_parent() ~= nil

	local size = go.get("#sprite", "size")

	msg.post(CONTROLLER, "register", {
		kind = hash("desk"),
		id   = go.get_id(),
		x = wp.x, y = wp.y, z = z,
		hw = 0.5 * size.x * scale.x,
		hh = 0.5 * size.y * scale.y,
		w_coffee = self.coffee,
		w_paper  = self.paper,
		w_cats   = self.cats,
	})
end

function update(self, dt)
	if self.reapply_depth then
		office.apply_depth()
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("register_icon") then
		self.icon = message.icon           -- the child request-icon linked itself
	elseif message_id == hash("show_icon") then
		tell_icon(self, "show_request", { type = message.type })   -- icon picks the image
		play("#snd_request")                 -- a new request appeared
	elseif message_id == hash("fulfilled") then
		local snd = DELIVER_SOUND[message.type]
		if snd then play(snd) end            -- worker got what they wanted
		tell_icon(self, "hide_request")
	end
end
